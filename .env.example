# ---- App
APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
WEBHOOK_BASE_URL=http://localhost:8001
EXPOSE_DOCS=true
LOG_LEVEL=INFO

# ---- Security (generate: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())")
JWT_SECRET=dev-only-jwt-secret-change-me
ENCRYPTION_MASTER_KEYS=
CSRF_SECRET=dev-only-csrf-secret-change-me
# Allow customer DBs / custom LLM endpoints on private networks (needed for the local hr-demo-db)
ALLOW_PRIVATE_ENDPOINTS=true

# ---- Data (host ports from infra/compose/docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://agentdesk:agentdesk@localhost:5433/agentdesk
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=agentdesk
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- LLM (set at least one provider key; "fake/chat" answers with canned text and needs no key)
DEFAULT_CHAT_MODEL=fake/chat
DEFAULT_UTILITY_MODEL=
# Embeddings: in-process ONNX (no key), or the self-hosted TEI container from compose:
#   DEFAULT_EMBEDDING_MODEL=openai/BAAI/bge-base-en-v1.5 + EMBEDDING_API_BASE=http://localhost:8082/v1
# or text-embedding-3-small with OPENAI_API_KEY
DEFAULT_EMBEDDING_MODEL=fastembed/BAAI/bge-small-en-v1.5
EMBEDDING_API_BASE=
# Any OpenAI-compatible server (vLLM, Ollama, LM Studio, LiteLLM proxy) as the platform model:
#   DEFAULT_CHAT_MODEL=openai/<model-name>, DEFAULT_LLM_API_BASE=http://host:port/v1, OPENAI_API_KEY=<key>
DEFAULT_LLM_API_BASE=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
# TypeSafe JEV: when set, the router and the SQL intent gate use it instead of the utility LLM
JEV_API_KEY=

# ---- Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentdesk-local
LANGSMITH_TRACING=false
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---- Email (Resend in prod; Mailpit SMTP in dev at http://localhost:8025)
RESEND_API_KEY=
EMAIL_FROM="AgentDesk <no-reply@agentdesk.local>"
SMTP_HOST=localhost
SMTP_PORT=1025

# ---- OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- WhatsApp
WA_GRAPH_API_VERSION=v21.0

# ---- Limits
MAX_UPLOAD_MB=25
ORG_STORAGE_LIMIT_MB=500
RUN_TIMEOUT_SECONDS=90

# ---- Demo seed (hr-demo-db from compose dev profile)
HR_DEMO_DATABASE_URL=postgresql://hr_demo:hr_demo@localhost:5434/hr_demo
# host of hr-demo-db as seen from the API process: localhost when running natively, hr-demo-db inside Docker
HR_DEMO_HOST=localhost
